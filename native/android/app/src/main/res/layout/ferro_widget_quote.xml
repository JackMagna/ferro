<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ferro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ferro_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/ferro_widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/ferro_quote_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/ferro_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="«La fatica non è mai sprecata. Soffri, ma sogni.»"
                android:textColor="#EEEBE4"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:ellipsize="end"
                android:maxLines="5" />
            <TextView
                android:id="@+id/ferro_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="— Pietro Mennea"
                android:textColor="#F0C33C"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/ferro_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fermo da 3 giorni. Oggi si torna: Giorno 2."
            android:textColor="#A8A69E"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
