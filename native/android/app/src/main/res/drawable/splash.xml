<?xml version="1.0" encoding="utf-8"?>
<!-- Schermata di avvio fino ad Android 11 (da Android 12 il sistema usa l'icona e ferro_splash_background). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ferro_splash_background" />
    <item android:width="96dp" android:height="96dp" android:gravity="center">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#F0C33C" /><corners android:radius="22dp" /></shape></item>
            <item android:drawable="@drawable/ferro_launcher_foreground" android:left="-6dp" android:top="-6dp" android:right="-6dp" android:bottom="-6dp" />
        </layer-list>
    </item>
</layer-list>
